{
  "version": 2,
  "builds": [
    {
      "src": "analyzer_server.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "analyzer_server.py"
    }
  ],
  "env": {
    "PYTHON_VERSION": "3.11"
  },
  "functions": {
    "analyzer_server.py": {
      "memory": 3008,
      "maxDuration": 60
    }
  }
}
